



# Flask App Security & Secret Key
SECRET_KEY=your-super-secret-key-here

# Database Configuration (Defaults to SQLite if left as is, or swap to PostgreSQL/MySQL)
DATABASE_URL=sqlite:///crm.db

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# WooCommerce REST API & Webhook Configuration
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret

# Email & SMTP Settings (For Birthday & Anniversary Notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=notifications@kwcrm.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=notifications@kwcrm.com
